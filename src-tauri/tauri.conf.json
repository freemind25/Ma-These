{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "ThesisFrame",
  "version": "1.3.0",
  "identifier": "com.thesisframe.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build:tauri",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../.next/standalone"
  },
  "app": {
    "title": "ThesisFrame",
    "windows": [
      {
        "title": "ThesisFrame — Assistant de thèse",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "theme": "light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../db/*": "db/",
      "../public/*": "public/"
    },
    "windows": {
      "nsis": {
        "languages": ["French", "English"],
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "copyright": "Copyright © 2025 ThesisFrame",
    "shortDescription": "Assistant intelligent pour la rédaction de thèses de doctorat",
    "longDescription": "ThesisFrame est une application de bureau complète pour la rédaction de thèses de doctorat. Elle intègre 29 modules fonctionnels, 5 fournisseurs d'IA (Z.ai, OpenAI, Anthropic, Mistral, RoutesMe), un éditeur riche avec prédiction de texte IA, un module RAG (Mon IA de thèse), et bien plus."
  }
}
