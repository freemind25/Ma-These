# ═══════════════════════════════════════════════════════════════
# Ma Thèse / ThesisFrame — modèle de configuration d'environnement
# Copier vers .env puis remplacer chaque placeholder par une valeur réelle.
# Aucune valeur réelle dans ce fichier — généré par l'audit prod-readiness-audit
# (T13 / C-D1) depuis l'inventaire exact des process.env.* lues par src/ (35 vars).
# ═══════════════════════════════════════════════════════════════

# ── Base de données ─────────────────────────────────────────────
# SQLite local (workflow db:push, aucune migration versionnée).
DATABASE_URL="file:./db/custom.db"

# ── Fournisseurs IA (clés) ──────────────────────────────────────
# Tout est optionnel : sans clé, un provider est simplement indisponible.
# Ces clés sont lues côté serveur uniquement (src/lib/ai/hardcoded-keys.ts
# lit process.env, ne contient aucune valeur).
ANTHROPIC_API_KEY="your-key-here"
APINEX_API_KEY="your-key-here"
CEREBRAS_API_KEY="your-key-here"
COHERE_API_KEY="your-key-here"
GEMINI_API_KEY="your-key-here"
GITHUB_MODELS_TOKEN="your-key-here"
GITHUB_TOKEN="your-key-here"
GOOGLE_API_KEY="your-key-here"
GROQ_API_KEY="your-key-here"
HF_TOKEN="your-key-here"
HUGGINGFACE_API_KEY="your-key-here"
KIRA_API_KEY="your-key-here"
MISTRAL_API_KEY="your-key-here"
NVIDIA_API_KEY="your-key-here"
OMNIROUTE_API_KEY="your-key-here"
OPENAI_API_KEY="your-key-here"
OPENROUTER_API_KEY="your-key-here"
OPENROUTER_BACKUP_KEY="your-key-here"
ROUTESME_API_KEY="your-key-here"
SILICONFLOW_API_KEY="your-key-here"

# ── Recherche académique ────────────────────────────────────────
# OPENALEX_API_KEY : optionnelle — sans elle, quota anonyme OpenAlex et
# bascule automatique CrossRef + HAL (deep-research, mécanisme A.2 prouvé).
# Fournie par l'environnement au lancement (desktop : variable système,
# plus aucune clé dans le binaire depuis T14 / C-D2 option a).
OPENALEX_API_KEY="your-key-here"
CORE_API_KEY="your-key-here"

# ── Endpoints / modèles (surcharges optionnelles) ───────────────
AI_BASE_URL="your-base-url-here"
AI_MODEL="your-model-here"
AI_PROVIDER="your-provider-here"
APINEX_BASE_URL="your-base-url-here"
OPENAI_BASE_URL="your-base-url-here"

# ── Tunables applicatifs ────────────────────────────────────────
# Timeout du chat directeur (A.9) : nominal 150 000 ms, relance 120 000 ms,
# borné côté schéma 5 000 → 180 000 ms.
DIRECTEUR_TIMEOUT_MS="150000"
DIRECTEUR_RETRY_TIMEOUT_MS="120000"
# Pondérations RAG (somme attendue = 1).
RAG_SEMANTIC_WEIGHT="0.5"
RAG_KEYWORD_WEIGHT="0.5"

# ── Runtime (définies par l'environnement d'exécution) ──────────
# Ne pas définir manuellement : NODE_ENV / NEXT_RUNTIME / PORT / TAURI
# sont fournies par Next.js, la plateforme d'hébergement ou le launcher
# Tauri (src-tauri/src/lib.rs). Listées pour exhaustivité de l'inventaire.
