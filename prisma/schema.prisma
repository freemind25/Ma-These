// ThesisFrame — Prisma Schema v1.0
// Base de données SQLite pour l'assistant de thèse

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════
// THÈSE — Structure principale
// ═══════════════════════════════════════

model Thesis {
  id            String    @id @default(cuid())
  title         String
  subtitle      String?
  author        String
  email         String?
  institution   String?
  laboratory    String?
  discipline    String?
  directorName  String?
  status        String    @default("draft") // draft | in_progress | review | completed
  structureMode String    @default("chapters") // chapters | parts
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  chapters      Chapter[]
  parts         Part[]
  cadrages      ThesisCadrage[]
}

model Chapter {
  id              String    @id @default(cuid())
  thesisId        String
  number          Int
  title           String
  romanNumeral    String?   // I, II, III, IV, etc.
  content         String    @default("") // HTML content from Tiptap
  plainText       String    @default("")
  wordCount       Int       @default(0)
  targetWordCount Int       @default(0)
  status          String    @default("not_started") // not_started | in_progress | draft | review | completed
  directorFeedback String?
  parentId        String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  thesis          Thesis    @relation(fields: [thesisId], references: [id], onDelete: Cascade)

  @@index([thesisId])
  @@index([parentId])
}

model Part {
  id        String  @id @default(cuid())
  thesisId  String
  title     String
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thesis    Thesis  @relation(fields: [thesisId], references: [id], onDelete: Cascade)

  @@index([thesisId])
}

// ═══════════════════════════════════════
// CADRAGE — Cadrage préliminaire
// ═══════════════════════════════════════

model ThesisCadrage {
  id          String    @id @default(cuid())
  thesisId    String
  label       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  thesis      Thesis    @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  fields      ThesisCadrageField[]
  versions    ThesisCadrageVersion[]

  @@index([thesisId])
}

model ThesisCadrageField {
  id            String   @id @default(cuid())
  cadrageId     String
  fieldKey      String   // e.g. "theme", "problématique", "methodologie"
  label         String
  value         String?
  aiSuggestion  String?
  isLocked      Boolean  @default(false)
  sortOrder     Int      @default(0)

  cadrage       ThesisCadrage @relation(fields: [cadrageId], references: [id], onDelete: Cascade)

  @@unique([cadrageId, fieldKey])
  @@index([cadrageId])
}

model ThesisCadrageVersion {
  id          String   @id @default(cuid())
  cadrageId   String
  label       String?
  snapshot    String   // JSON snapshot of all fields
  createdAt   DateTime @default(now())

  cadrage     ThesisCadrage @relation(fields: [cadrageId], references: [id], onDelete: Cascade)

  @@index([cadrageId])
}

// ═══════════════════════════════════════
// RÉFÉRENCES BIBLIOGRAPHIQUES
// ═══════════════════════════════════════

model Reference {
  id          String   @id @default(cuid())
  type        String   @default("article") // article | book | thesis | conference | report | web | other
  authors     String   // Semicolon separated
  title       String
  year        Int?
  journal     String?
  volume      String?
  issue       String?
  pages       String?
  publisher   String?
  doi         String?
  isbn        String?
  url         String?
  abstract    String?
  keywords    String?  // Comma separated tags
  notes       String?
  bibtexKey   String?  // Custom BibTeX citation key
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([year])
  @@index([isFavorite])
}

// ═══════════════════════════════════════
// CARNET DE RECHERCHE
// ═══════════════════════════════════════

model ResearchSource {
  id          String        @id @default(cuid())
  title       String
  authors     String?
  year        Int?
  type        String        @default("article") // article | book | thesis | report
  url         String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  entries     NotebookEntry[]

  @@index([type])
}

model NotebookEntry {
  id          String         @id @default(cuid())
  sourceId    String?
  question    String
  answer      String
  tags        String?        // Comma separated
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  source      ResearchSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([sourceId])
}

// ═══════════════════════════════════════
// CONFIGURATION IA
// ═══════════════════════════════════════

model AiToolConfig {
  id        String   @id @default(cuid())
  provider  String   @unique // openai | anthropic | mistral | zai | custom
  apiKey    String?
  model     String?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════
// GESTION AGILE
// ═══════════════════════════════════════

model AgileSprint {
  id          String      @id @default(cuid())
  phase       String      // phase_0 | phase_1 | phase_2 | phase_3 | phase_4
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      String      @default("planned") // planned | active | completed
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  stories     AgileStory[]

  @@index([phase])
  @@index([status])
}

model AgileStory {
  id          String      @id @default(cuid())
  sprintId    String
  title       String
  description String?
  status      String      @default("todo") // todo | in_progress | done
  priority    String      @default("medium") // low | medium | high | critical
  storyPoints Int?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  sprint      AgileSprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@index([sprintId])
  @@index([status])
}

// ═══════════════════════════════════════
// COMPÉTENCES LIVRES
// ═══════════════════════════════════════

model CustomBookSkill {
  id          String   @id @default(cuid())
  title       String
  author      String?
  content     String   // Extracted knowledge text
  tags        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([title])
}

// ═══════════════════════════════════════
// LICENCE (simplifié)
// ═══════════════════════════════════════

model LicenseKey {
  id                   String   @id @default(cuid())
  keyHash              String   @unique          // SHA-256 hash of the license key
  keyPrefix            String                     // First 8 chars for admin display
  licenseType          String   @default("trial") // trial | standard | academic | premium
  status               String   @default("active")    // active | revoked | expired
  maxActivations       Int      @default(3)
  currentActivations   Int      @default(0)
  note                 String?
  email                String?
  expiresAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  activations          Activation[]

  @@index([licenseType])
  @@index([status])
}

model Activation {
  id                String     @id @default(cuid())
  licenseKeyId      String
  sessionToken      String     @unique          // Token stored in cookie
  deviceName        String?
  deviceFingerprint String?
  ipAddress         String?
  activatedAt       DateTime   @default(now())
  lastSeenAt        DateTime   @default(now())
  licenseKey        LicenseKey @relation(fields: [licenseKeyId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@index([licenseKeyId])
}

// ═══════════════════════════════════════
// MENDELEY — Intégration bibliographique
// ═══════════════════════════════════════

model MendeleyConfig {
  id            String    @id @default(cuid())
  clientId      String?
  clientSecret  String?
  accessToken   String?
  refreshToken  String?
  tokenExpiresAt DateTime?
  connected     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ═══════════════════════════════════════
// CLOUD DRIVE — Sauvegarde cloud
// ═══════════════════════════════════════

model CloudDriveConnection {
  id             String    @id @default(cuid())
  provider       String    @default("google_drive") // google_drive | onedrive | dropbox
  connected      Boolean   @default(false)
  email          String?
  displayName    String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt  DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ═══════════════════════════════════════
// AUTH — Fournisseurs d'authentification
// ═══════════════════════════════════════

model AuthProvider {
  id           String   @id @default(cuid())
  provider     String   @unique          // "auth0" | "stytch" | "warrant"
  enabled      Boolean  @default(false)
  clientId     String?                    // API Key / Client ID
  clientSecret String?                   // Client Secret
  domain       String?                    // Auth0 domain, Stytch project URL
  extraConfig  String?                    // JSON: allowed connections, features, etc.
  connected    Boolean  @default(false)
  lastTestedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  accounts     AuthAccount[]
}

model AuthAccount {
  id             String       @id @default(cuid())
  providerId     String
  provider       AuthProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerUserId String                          // External user ID
  email          String?
  name           String?
  avatarUrl      String?
  accessToken    String?                         // Encrypted
  refreshToken   String?                         // Encrypted
  tokenExpiresAt DateTime?
  metadata       String?                         // JSON: extra provider-specific data
  lastLoginAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([providerId, providerUserId])
  @@index([email])
}

// ═══════════════════════════════════════
// WARRANT — Politiques d'autorisation
// ═══════════════════════════════════════

model WarrantPolicy {
  id           String   @id @default(cuid())
  policyType   String                      // "feature_gate" | "role" | "resource_access"
  policyKey    String                       // e.g. "ai_writing", "export_pdf", "admin_panel"
  licenseTypes String                      // JSON array of license types
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([policyType, policyKey])
}

// ═══════════════════════════════════════
// VÉRIFICATION MÉTHODOLOGIQUE
// ═══════════════════════════════════════

model ElementAnalyse {
  id            String    @id @default(cuid())
  nom           String
  typeElement   String
  natureElement String
  sousAnalyse   String?
  source        String
  dateSource    DateTime?
  geojson       String?
  styleConfig   String?
  chapitreId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([typeElement])
  @@index([natureElement])
}

model TypeAnalyseMethodologique {
  id                 String   @id @default(cuid())
  discipline         String
  nom                String
  elementsAttendus   String
  promptQuestionneur String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([discipline, nom])
}

model SessionVerification {
  id                String   @id @default(cuid())
  siteEtudeId       String
  typeAnalyseId     String
  elementsManquants String
  questionsPosees   String
  reponses          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ═══════════════════════════════════════
// RECHERCHE — Bibliothèque + Fiches + Veille
// ═══════════════════════════════════════

model SourceBibliographique {
  id           String   @id @default(cuid())
  titre        String
  auteurs      String   // JSON: [{nom, prenom}]
  annee        Int?
  doi          String?
  type         String   @default("article") // article | ouvrage | these | rapport | chapitre
  abstract     String?  // résumé original de la source
  journal      String?
  volume       String?
  pages        String?
  url          String?
  tags         String?  // JSON: string[]
  mendeleyId   String?
  zoteroId     String?
  chapitres    SourceChapitre[]
  fichesLecture FicheLecture[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
  @@index([annee])
}

model SourceChapitre {
  sourceId   String
  source     SourceBibliographique @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chapitreId String
  createdAt  DateTime @default(now())

  @@id([sourceId, chapitreId])
}

model FicheLecture {
  id             String   @id @default(cuid())
  sourceId       String
  source         SourceBibliographique @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chapitreId     String?
  problematique  String?
  methode        String?
  resultatsCles  String?
  limites        String?
  positionnement String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sourceId])
  @@index([chapitreId])
}

model RechercheSauvegardee {
  id                String    @id @default(cuid())
  requete           String
  filtres           String?   // JSON: { discipline, periode, langue, type }
  alerteActive      Boolean   @default(false)
  derniereExecution DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ═══════════════════════════════════════
// BASE DE CONNAISSANCES — Documents + Chunks (SurfSense-inspired)
// ═══════════════════════════════════════

model KnowledgeDocument {
  id          String   @id @default(cuid())
  title       String
  fileName    String?
  fileType    String   @default("text") // text | pdf | markdown | image | audio
  content     String   // Extracted full text
  plainText   String   // Normalized plain text for search
  metadata    String?  // JSON: { authors, year, journal, doi, pages, language }
  tags        String?  // Comma separated
  sourceType  String   @default("upload") // upload | url | reference | mendeley
  sourceRef   String?  // ID of the source (Reference.id, Mendeley doc id, etc.)
  thesisId    String?  // Optional link to a thesis
  wordCount   Int      @default(0)
  chunkCount  Int      @default(0)
  isIndexed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chunks      KnowledgeChunk[]
  citations   Citation[]

  @@index([fileType])
  @@index([sourceType])
  @@index([thesisId])
  @@index([isIndexed])
}

model KnowledgeChunk {
  id              String   @id @default(cuid())
  documentId      String
  document        KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content         String   // Chunk text content
  plainText       String   // Normalized for search
  chunkIndex      Int      // Position in document
  charStart       Int      // Start character offset
  charEnd         Int       // End character offset
  wordCount       Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([documentId])
}

// ═══════════════════════════════════════
// CITATIONS — Tracking AI response sources
// ═══════════════════════════════════════

model Citation {
  id              String   @id @default(cuid())
  documentId      String?
  document        KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  chunkId         String?
  chapterId       String?
  quotedText      String   // The text being cited
  context         String?  // Surrounding context
  citationStyle   String   @default("apa") // apa | mla | chicago | ieee | vancouver
  referenceText   String?  // Formatted citation string
  sessionId       String?  // AI conversation session
  createdAt       DateTime @default(now())

  @@index([documentId])
  @@index([chapterId])
  @@index([sessionId])
}

// ═══════════════════════════════════════
// MÉMOIRE DE RECHERCHE — Persistent cross-session context
// ═══════════════════════════════════════

model ResearchMemory {
  id          String   @id @default(cuid())
  category    String   // theme | methodologie | problématique | reference | hypothese | cadre | result | note
  key         String   // Short identifier
  value       String   // Memory content
  thesisId    String?
  importance  Int      @default(5) // 1-10 priority
  isExpired   Boolean  @default(false)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([category, key, thesisId])
  @@index([category])
  @@index([thesisId])
  @@index([importance])
}
