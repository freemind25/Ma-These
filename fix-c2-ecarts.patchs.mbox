diff --git a/src/lib/api/api-fetch.ts b/src/lib/api/api-fetch.ts
new file mode 100644
index 0000000..2c6eba4
--- /dev/null
+++ b/src/lib/api/api-fetch.ts
@@ -0,0 +1,63 @@
+"use client";
+
+// ═══════════════════════════════════════════════════════════════
+// C2-E2 — Client HTTP centralisé : toute erreur serveur devient un
+// toast visible (sonner, monté dans layout.tsx) + une exception.
+// Historique : les mutations échouaient en silence — l'utilisateur
+// voyait « rien ne se passe » (écart bloquant C2-E2, audit
+// 2026-10-16 : P2021/P2022 renvoyés par le serveur mais ignorés).
+// ═══════════════════════════════════════════════════════════════
+
+import { toast } from "sonner";
+
+export class ApiError extends Error {
+  status: number;
+  code?: string;
+  constructor(message: string, status: number, code?: string) {
+    super(message);
+    this.name = "ApiError";
+    this.status = status;
+    this.code = code;
+  }
+}
+
+export interface ApiJsonEnvelope<T> {
+  data?: T;
+  error?: string;
+  code?: string;
+}
+
+export async function apiJson<T = unknown>(
+  url: string,
+  init?: RequestInit,
+  opts?: { silent?: boolean }
+): Promise<T> {
+  let res: Response;
+  try {
+    res = await fetch(url, init);
+  } catch (e) {
+    // Serveur injoignable (arrêt en cours, orphelin, etc.)
+    if (!opts?.silent) {
+      toast.error("Le serveur n'a pas répondu", {
+        description:
+          "Relancez l'application. Si le problème persiste, consultez server.log.",
+      });
+    }
+    throw e;
+  }
+
+  const json = (await res.json().catch(() => null)) as
+    | ApiJsonEnvelope<T>
+    | null;
+
+  if (!res.ok) {
+    const message = json?.error || `Erreur ${res.status}`;
+    if (!opts?.silent) {
+      toast.error("L'opération a échoué", { description: message });
+    }
+    throw new ApiError(message, res.status, json?.code);
+  }
+
+  // Routes enveloppées {data, meta} → renvoyer data ; sinon l'objet brut.
+  return (json && json.data !== undefined ? json.data : (json as unknown)) as T;
+}
diff --git a/src/lib/api/db-errors.ts b/src/lib/api/db-errors.ts
new file mode 100644
index 0000000..fbde00a
--- /dev/null
+++ b/src/lib/api/db-errors.ts
@@ -0,0 +1,79 @@
+// ═══════════════════════════════════════════════════════════════
+// C2-E2 — Traduction des erreurs Prisma en réponses HTTP explicites.
+// Historique : les routes renvoyaient un 500 générique (« Erreur lors
+// de … ») sans code Prisma, et le client n'affichait rien →
+// « rien ne se passe » pour l'utilisateur (écart bloquant C2-E2,
+// audit 2026-10-16 : P2021/P2022 sur base obsolète, remédiée à la
+// main — le codage restait fail-open).
+// ═══════════════════════════════════════════════════════════════
+
+import { NextResponse } from "next/server";
+import { Prisma } from "@prisma/client";
+
+export interface DbErrorTranslation {
+  status: number;
+  body: { error: string; code?: string };
+}
+
+export function translateDbError(
+  error: unknown,
+  fallback = "Erreur interne du serveur"
+): DbErrorTranslation {
+  if (error instanceof Prisma.PrismaClientKnownRequestError) {
+    switch (error.code) {
+      case "P2021":
+        return {
+          status: 503,
+          body: {
+            error:
+              "Base de données obsolète ou corrompue (table manquante). Mettez à jour l'application — vos données sont conservées.",
+            code: "P2021",
+          },
+        };
+      case "P2022":
+        return {
+          status: 503,
+          body: {
+            error:
+              "Base de données obsolète (champ manquant). Mettez à jour l'application — vos données sont conservées.",
+            code: "P2022",
+          },
+        };
+      case "P2002":
+        return {
+          status: 409,
+          body: { error: "Doublon : un élément identique existe déjà.", code: "P2002" },
+        };
+      case "P2025":
+        return {
+          status: 404,
+          body: { error: "Élément introuvable (déjà supprimé ?).", code: "P2025" },
+        };
+      case "P2003":
+        return {
+          status: 409,
+          body: {
+            error: "Impossible de supprimer : cet élément est référencé ailleurs.",
+            code: "P2003",
+          },
+        };
+    }
+  }
+  if (error instanceof Prisma.PrismaClientInitializationError) {
+    return {
+      status: 503,
+      body: {
+        error:
+          "Base de données inaccessible. Vérifiez que l'application n'est pas déjà ouverte ailleurs, puis relancez-la.",
+        code: "DB_INIT",
+      },
+    };
+  }
+  return { status: 500, body: { error: fallback } };
+}
+
+/** Réponse prête à l'emploi pour les catch génériques des routes API. */
+export function dbErrorResponse(error: unknown, fallback: string): NextResponse {
+  const t = translateDbError(error, fallback);
+  return NextResponse.json(t.body, { status: t.status });
+}
