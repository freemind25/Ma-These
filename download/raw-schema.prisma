    "html": "<html><head><meta name=\"color-scheme\" content=\"light dark\"></head><body><pre style=\"word-wrap: break-word; white-space: pre-wrap;\">generator client {\n  provider      = \"prisma-client-js\"\n  binaryTargets = [\"native\", \"rhel-openssl-3.0.x\", \"linux-musl-openssl-3.0.x\"]\n}\n\ndatasource db {\n  provider = \"sqlite\"\n  url      = env(\"DATABASE_URL\")\n}\n\nmodel MendeleyConfig {\n  id            String   @id @default(cuid())\n  clientId      String?\n  clientSecret  String?\n  accessToken   String?\n  refreshToken  String?\n  tokenExpiresAt DateTime?\n  connected     Boolean  @default(false)\n  createdAt     DateTime @default(now())\n  updatedAt     DateTime @updatedAt\n}\n\nmodel Reference {\n  id          String   @id @default(cuid())\n  type        String   @default(\"article\")\n  citationKey String?\n  title       String\n  authors     String\n  year        String?\n  journal     String?\n  volume      String?\n  number      String?\n  pages       String?\n  doi         String?\n  abstract    String?\n  tags        String?\n  notes       String?\n  source      String   @default(\"manual\")\n  mendeleyId  String?  @unique\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n\n  @@index([type])\n  @@index([source])\n}\n\n// ─── Thesis Editor Models ─────────────────────────────────────\n\nmodel Thesis {\n  id            String    @id @default(cuid())\n  title         String    @default(\"Ma thèse de doctorat\")\n  subtitle      String?\n  author        String    @default(\"Doctorant\")\n  field         String    @default(\"\")\n  university    String   @default(\"\")\n  status        String    @default(\"draft\")\n  structureMode String    @default(\"chapters\") // \"chapters\" | \"parts\"\n  createdAt     DateTime  @default(now())\n  updatedAt     DateTime  @updatedAt\n  chapters      Chapter[]\n  parts         Part[]\n  cadrage       ThesisCadrage?\n}\n\nmodel Chapter {\n  id               String    @id @default(cuid())\n  thesisId         String\n  partId           String?\n  order            Int\n  number           String\n  title            String\n  content          String    @default(\"\")\n  wordCount        Int       @default(0)\n  status           String    @default(\"draft\")\n  directorFeedback String?\n  directorFeedbackAt DateTime?\n  createdAt        DateTime  @default(now())\n  updatedAt        DateTime  @updatedAt\n  thesis           Thesis    @relation(fields: [thesisId], references: [id], onDelete: Cascade)\n  part             Part?     @relation(fields: [partId], references: [id], onDelete: SetNull)\n\n  @@unique([thesisId, order])\n  @@index([thesisId])\n}\n\nmodel Part {\n  id        String    @id @default(cuid())\n  thesisId  String\n  title     String    @default(\"\")\n  order     Int\n  createdAt DateTime  @default(now())\n  updatedAt DateTime  @updatedAt\n  thesis    Thesis    @relation(fields: [thesisId], references: [id], onDelete: Cascade)\n  chapters  Chapter[]\n\n  @@unique([thesisId, order])\n}\n\nmodel CloudDriveConnection {\n  id           String    @id @default(cuid())\n  provider     String    @default(\"google_drive\") // google_drive, onedrive, dropbox\n  connected    Boolean   @default(false)\n  email        String?\n  displayName  String?\n  accessToken  String?\n  refreshToken String?\n  tokenExpiresAt DateTime?\n  lastSyncAt   DateTime?\n  createdAt    DateTime  @default(now())\n  updatedAt    DateTime  @updatedAt\n}\n\n// ─── Notebook (recherche assistée par IA sur sources) ────────\n\nmodel ResearchSource {\n  id         String   @id @default(cuid())\n  title      String\n  content    String\n  sourceType String   @default(\"text\")\n  tags       String?\n  createdAt  DateTime @default(now())\n  updatedAt  DateTime @updatedAt\n\n  @@index([sourceType])\n}\n\nmodel AiToolConfig {\n  id          String   @id @default(cuid())\n  tool        String   @unique\n  apiKey      String?\n  connected    Boolean  @default(false)\n  extraConfig String?\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n}\n\nmodel NotebookEntry {\n  id        String   @id @default(cuid())\n  question  String\n  answer    String\n  sourceIds String   @default(\"\")\n  createdAt DateTime @default(now())\n}\n\n// ─── License & Activation ────────────────────────────────────\n\nmodel LicenseKey {\n  id              String   @id @default(cuid())\n  keyHash         String   @unique          // SHA-256 hash of the license key\n  keyPrefix       String                     // First 8 chars in clear for admin display\n  licenseType     String   @default(\"standard\") // standard | academic | premium | trial\n  status          String   @default(\"active\")    // active | revoked | expired\n  maxActivations  Int      @default(3)\n  currentActivations Int    @default(0)\n  note            String?\n  createdAt       DateTime @default(now())\n  expiresAt       DateTime?\n  activations     Activation[]\n}\n\nmodel Activation {\n  id           String     @id @default(cuid())\n  licenseKeyId String\n  sessionToken String     @unique          // Token stored in cookie\n  deviceName   String?\n  deviceFingerprint String?\n  ipAddress    String?\n  activatedAt  DateTime   @default(now())\n  lastSeenAt   DateTime   @default(now())\n  licenseKey   LicenseKey @relation(fields: [licenseKeyId], references: [id], onDelete: Cascade)\n\n  @@index([sessionToken])\n  @@index([licenseKeyId])\n}\n\n// ─── Cadrage préalable (ThesisFrame) ──────────────────────────\n\nmodel ThesisCadrage {\n  id        String    @id @default(cuid())\n  thesisId  String    @unique\n  status    String    @default(\"provisoire\") // provisoire | valide | revise\n  version   Int       @default(1)\n  createdAt DateTime  @default(now())\n  updatedAt DateTime  @updatedAt\n  thesis    Thesis    @relation(fields: [thesisId], references: [id], onDelete: Cascade)\n  fields    ThesisCadrageField[]\n  versions  ThesisCadrageVersion[]\n}\n\nmodel ThesisCadrageField {\n  id             String         @id @default(cuid())\n  cadrageId      String\n  fieldKey       String         // thematique, problematique, questions_recherche, etc.\n  fieldValue     String         @default(\"\")\n  fieldMeta      String?        // JSON blob for sub-fields (objectives, methodology, etc.)\n  isAiSuggestion Boolean        @default(false)\n  editedByUser   Boolean        @default(false)\n  createdAt      DateTime       @default(now())\n  updatedAt      DateTime       @updatedAt\n  cadrage        ThesisCadrage  @relation(fields: [cadrageId], references: [id], onDelete: Cascade)\n\n  @@unique([cadrageId, fieldKey])\n}\n\nmodel ThesisCadrageVersion {\n  id        String         @id @default(cuid())\n  cadrageId String\n  version   Int\n  snapshot  String         // JSON snapshot of all fields\n  createdAt DateTime       @default(now())\n  cadrage   ThesisCadrage  @relation(fields: [cadrageId], references: [id], onDelete: Cascade)\n\n  @@unique([cadrageId, version])\n}\n\n// ─── External Auth Providers (Auth0, Stytch, Warrant) ──────\n\nmodel AuthProvider {\n  id          String   @id @default(cuid())\n  provider    String   @unique          // \"auth0\" | \"stytch\" | \"warrant\"\n  enabled     Boolean  @default(false)\n  clientId    String?                    // API Key / Client ID\n  clientSecret String?                   // Client Secret (encrypted at rest by env)\n  domain      String?                    // Auth0 domain, Stytch project URL, Warrant API URL\n  extraConfig String?                    // JSON: allowed connections, features, etc.\n  connected   Boolean  @default(false)\n  lastTestedAt DateTime?\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n  accounts    AuthAccount[]\n}\n\nmodel AuthAccount {\n  id             String       @id @default(cuid())\n  providerId     String\n  provider       AuthProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)\n  providerUserId String                          // External user ID from provider\n  email          String?\n  name           String?\n  avatarUrl      String?\n  accessToken    String?                         // Encrypted\n  refreshToken   String?                         // Encrypted\n  tokenExpiresAt DateTime?\n  metadata       String?                         // JSON: extra provider-specific data\n  lastLoginAt    DateTime?\n  createdAt      DateTime    @default(now())\n  updatedAt      DateTime    @updatedAt\n\n  @@unique([providerId, providerUserId])\n  @@index([email])\n}\n\n// ─── Warrant: Authorization Policies ─────────────────────────\n\nmodel WarrantPolicy {\n  id          String   @id @default(cuid())\n  policyType  String                      // \"feature_gate\" | \"role\" | \"resource_access\"\n  policyKey   String                       // e.g. \"ai_writing\", \"export_pdf\", \"admin_panel\"\n  licenseTypes String                      // JSON array of license types that grant access\n  description  String?\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n\n  @@unique([policyType, policyKey])\n}\n\n// ─── Custom Book Skills (user-imported books) ────────────\n\nmodel CustomBookSkill {\n  id            String   @id @default(cuid())\n  title         String\n  author        String   @default(\"\")\n  coreConcept   String   @default(\"\")\n  frameworks    String   @default(\"[]\") // JSON: Array<{name, description, when}>\n  principles    String   @default(\"[]\") // JSON: string[]\n  techniques    String   @default(\"[]\") // JSON: string[]\n  antiPatterns  String   @default(\"[]\") // JSON: string[]\n  relevance     String   @default(\"[]\") // JSON: Array<{chapterType, reason}>\n  quickReference String  @default(\"\")\n  glossary      String   @default(\"\") // JSON: Array<{term, definition}>\n  fileName      String\n  fileSize      Int      @default(0)\n  status        String   @default(\"processing\") // processing | ready | error\n  errorMessage  String   @default(\"\")\n  createdAt     DateTime @default(now())\n  updatedAt     DateTime @updatedAt\n}\n\n// ─── Vérification méthodologique (Module A + B) ────────────\n\nmodel ElementAnalyse {\n  id            String    @id @default(cuid())\n  nom           String\n  typeElement   String\n  natureElement String\n  sousAnalyse   String?\n  source        String\n  dateSource    DateTime?\n  geojson       String?\n  styleConfig   String?\n  chapitreId    String?\n  createdAt     DateTime  @default(now())\n  updatedAt     DateTime  @updatedAt\n\n  @@index([typeElement])\n  @@index([natureElement])\n}\n\nmodel TypeAnalyseMethodologique {\n  id                 String   @id @default(cuid())\n  discipline         String\n  nom                String\n  elementsAttendus   String\n  promptQuestionneur String?\n  createdAt          DateTime @default(now())\n  updatedAt          DateTime @default(now())\n\n  @@unique([discipline, nom])\n}\n\nmodel SessionVerification {\n  id               String   @id @default(cuid())\n  siteEtudeId      String\n  typeAnalyseId    String\n  elementsManquants String\n  questionsPosees  String\n  reponses         String?\n  createdAt        DateTime @default(now())\n  updatedAt        DateTime @default(now())\n}\n\n// ─── Onglet Recherche (bibliothèque + fiches + veille) ─────\n\nmodel SourceBibliographique {\n  id            String   @id @default(cuid())\n  titre         String\n  auteurs       String   // JSON: [{nom, prenom}]\n  annee         Int?\n  doi           String?\n  type          String   @default(\"article\") // \"article\" | \"ouvrage\" | \"these\" | \"rapport\" | \"chapitre\"\n  abstract      String?  // résumé original de la source, jamais généré par ThesisFrame\n  journal       String?\n  volume        String?\n  pages         String?\n  url           String?\n  tags          String?  // JSON: string[]\n  mendeleyId    String?\n  zoteroId      String?\n  chapitres     SourceChapitre[]\n  fichesLecture FicheLecture[]\n  createdAt     DateTime @default(now())\n  updatedAt     DateTime @updatedAt\n\n  @@index([type])\n  @@index([annee])\n}\n\nmodel SourceChapitre {\n  sourceId   String\n  source     SourceBibliographique @relation(fields: [sourceId], references: [id], onDelete: Cascade)\n  chapitreId String\n  createdAt  DateTime @default(now())\n\n  @@id([sourceId, chapitreId])\n}\n\nmodel FicheLecture {\n  id             String   @id @default(cuid())\n  sourceId       String\n  source         SourceBibliographique @relation(fields: [sourceId], references: [id], onDelete: Cascade)\n  chapitreId     String?\n  problematique  String?  // rédigé par le chercheur — jamais pré-rempli par l'IA\n  methode        String?\n  resultatsCles  String?\n  limites        String?\n  positionnement String?  // en quoi cette source se rattache (ou s'oppose) à la thèse du chercheur\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  @@index([sourceId])\n  @@index([chapitreId])\n}\n\nmodel RechercheSauvegardee {\n  id               String    @id @default(cuid())\n  requete          String\n  filtres          String?   // JSON: { discipline, periode, langue, type }\n  alerteActive     Boolean   @default(false)\n  derniereExecution DateTime?\n  createdAt        DateTime  @default(now())\n  updatedAt        DateTime  @updatedAt\n}\n\n// ─── Agile Roadmap (Sprints & Stories) ────────────────────────\n\nmodel AgileSprint {\n  id          String   @id @default(cuid())\n  thesisId    String\n  sprintNumber Int      @unique\n  phase        String   // \"phase_0\" | \"phase_1\" | \"phase_2\" | \"phase_3\" | \"phase_4\"\n  title       String\n  description  String   @default(\"\")\n  deliverable String   @default(\"\")\n  status      String   @default(\"todo\") // todo | in_progress | done\n  startedAt   DateTime?\n  completedAt DateTime?\n  order       Int      @default(0)\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @default(now())\n  stories     AgileStory[]\n\n  @@index([thesisId, phase])\n}\n\nmodel AgileStory {\n  id          String   @id @default(cuid())\n  sprintId    String\n  title       String\n  description  String   @default(\"\")\n  status      String   @default(\"todo\") // todo | in_progress | done\n  order       Int      @default(0)\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n  sprint      AgileSprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)\n\n  @@index([sprintId, status])\n}</pre></body></html>",
